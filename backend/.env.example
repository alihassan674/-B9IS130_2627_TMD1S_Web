# TravelLog Backend - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/travellog?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/travellog
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/travellog?retryWrites=true&w=majority

# JSON Web Token (JWT) Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

